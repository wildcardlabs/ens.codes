# Copy to .env.local for local work, or set these in Vercel (Project → Settings → Environment Variables).
# Everything here ends up in the public site bundle, so none of it may be a secret.

# 1 = mainnet, 11155111 = Sepolia, 31337 = local anvil fork of mainnet.
VITE_CHAIN_ID=11155111

# A browser-reachable RPC for that network. If it carries an API key, restrict that key to the
# site's domain with the provider.
# Its host must also be listed under connect-src in ../vercel.json, or the browser blocks it.
VITE_RPC_URL=https://sepolia.gateway.tenderly.co

# Optional: the most blocks the RPC allows in one history request (default 10000).
# VITE_LOG_RANGE=10000

# Printed by scripts/deploy-sepolia.sh (or scripts/local-setup.sh for the local fork).
VITE_VAULT=
VITE_VAULT_DEPLOY_BLOCK=

# Local fork only: adds a built-in test wallet. Ignored on any other network.
# VITE_DEV_WALLET=1
